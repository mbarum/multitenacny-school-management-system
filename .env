# ==========================================
# SAASLINK SCHOOL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==========================================

# --- APPLICATION & ENVIRONMENT ---
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# --- MYSQL DATABASE CONFIGURATION ---
# The system supports individual connection credentials OR a full DATABASE_URL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=saaslink_db
MYSQL_USER=saaslink_user
MYSQL_PASSWORD=your_strong_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password
# Optional combined database connection string:
# DATABASE_URL=mysql://saaslink_user:your_strong_mysql_password@127.0.0.1:3306/saaslink_db

# --- REDIS CONFIGURATION (Queues, Background Tasks & Throttling) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional combined Redis connection string:
# REDIS_URL=redis://:your_redis_password@127.0.0.1:6379

# --- SECURITY & AUTHENTICATION (Zero Trust) ---
# Mandatory 256-bit or 512-bit cryptographically random string for signing JWT tokens
JWT_SECRET=generate_a_minimum_32_character_random_secret_here

# --- AI & COPILOT INTEGRATION ---
# Google Gemini API key for server-side AI features
API_KEY=

# --- EMAIL / SMTP NOTIFICATIONS ---
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Saaslink School Management" <no-reply@your-domain.com>
SMTP_REJECT_UNAUTHORIZED=false

# --- STRIPE BILLING & PAYMENTS ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- SAFARICOM M-PESA DARAJA API (STK Push & C2B) ---
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_PAYBILL=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# --- PRODUCTION STRICT API & MOCK DATA CONTROLS ---
# The system operates strictly with live production backend data by default.
# Only live data from the database is used; all mock data fallbacks are disabled.
VITE_DISABLE_MOCK_FALLBACK=true
VITE_STRICT_API=true
VITE_ENABLE_MOCK_FALLBACK=false

