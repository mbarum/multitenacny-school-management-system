# ==========================================
# SAASLINK BACKEND - ENVIRONMENT CONFIGURATION
# ==========================================

PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# Database (MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=saaslink_db
MYSQL_USER=saaslink_user
MYSQL_PASSWORD=your_strong_mysql_password
MYSQL_ROOT_PASSWORD=
# DATABASE_URL=mysql://saaslink_user:your_strong_mysql_password@127.0.0.1:3306/saaslink_db

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://:your_redis_password@127.0.0.1:6379

# Authentication (Zero Trust JWT Secret)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# AI Integration
API_KEY=

# Email / Notifications
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Saaslink" <no-reply@your-domain.com>
SMTP_REJECT_UNAUTHORIZED=true

# Billing & Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# M-Pesa Integration
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_PAYBILL=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

