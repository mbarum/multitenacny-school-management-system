{
  "name": "saaslink-school-management",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "bash ./scripts/ensure-services.sh && concurrently \"PORT=3001 node server/dist/main\" \"vite\"",
    "lint": "tsc",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:sync": "npm --prefix server run db:sync",
    "seed": "npm --prefix server run seed",
    "db:test": "npm --prefix server run db:test",
    "db:inspect": "npm --prefix server run db:inspect",
    "server:dev": "npm --prefix server run start:dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start:prod",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop saaslink-emis",
    "pm2:restart": "pm2 restart saaslink-emis",
    "pm2:logs": "pm2 logs saaslink-emis",
    "start": "PORT=3000 npm run server:prod"
  },
  "dependencies": {
    "@google/genai": "^1.29.1",
    "@stripe/react-stripe-js": "^2.4.0",
    "@stripe/stripe-js": "^2.4.0",
    "@tanstack/react-query": "^5.28.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^13.0.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "lucide-react": "^1.43.0",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.4",
    "react-router-dom": "^6.22.3",
    "recharts": "^3.4.1",
    "socket.io-client": "^4.7.5",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
